PORT=4000
# Any long random text. Required in production.
JWT_SECRET=change-me

# The database. On this computer: SQLite in DB_PATH (nothing to install). Online: PostgreSQL, e.g. a free Neon
# database, with DB_ENGINE=postgres and DATABASE_URL=<Neon's connection string>.
DB_PATH=./data/shambasmart.db
# DB_ENGINE=postgres
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# For `yarn test:postgres` only: a local PostgreSQL database whose name ends in _test.
# TEST_DATABASE_URL=postgresql://user:password@localhost:5432/something_test

# The crop photo check uses Meta's Llama 4 Scout on Cloudflare Workers AI (free: 10,000 "neurons" a day, roughly
# 60-90 photo checks). Free account at https://dash.cloudflare.com, then:
#   - the Account ID: on the account home page (Account details) or in the dashboard address after /dash.cloudflare.com/
#   - an API token: My Profile > API Tokens > Create Token > "Workers AI" template
# Without these, the photo check says it is not set up; everything else still works.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Other free services that also work (used only when Cloudflare is not set):
#   Google Gemini: free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
#   Groq: free key at https://console.groq.com/keys
GROQ_API_KEY=
# Or force one: VISION_PROVIDER=cloudflare | gemini | groq | ollama, and optionally VISION_MODEL=<another model there>

# How many photos one farmer may check per day (the free services have a daily allowance in all).
DIAGNOSES_PER_DAY=10
